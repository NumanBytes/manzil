# ---------------------------------------------------------------------------
# Local development reads this single file at the repo root.
# Copy it to .env and fill in the blanks:  cp .env.example .env
#
# In production each service gets these from its host instead:
#   apps/web -> Vercel project settings
#   apps/api -> Railway service variables
# ---------------------------------------------------------------------------

# --- Database (used by apps/api and the Prisma CLI in packages/db) ----------
# Local Postgres from docker-compose.yml (note the 5433 host port):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/manzil?schema=public"
# Railway gives you a connection string that looks like:
# DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"

# --- Shared session secret (apps/web AND apps/api) -------------------------
# Both services must hold the SAME value: the web app signs session tokens with
# it and the API verifies them. Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# --- Service-to-service secret (apps/web AND apps/api) ---------------------
# Authenticates the web app's NextAuth backend when it calls the API's internal
# /auth endpoints, before any user session exists. Also:  openssl rand -base64 32
INTERNAL_API_SECRET=""

# --- apps/api ---------------------------------------------------------------
PORT=4000
# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"
# Server-side only. Required once the AI/RAG endpoints are built.
ANTHROPIC_API_KEY=""

# --- apps/web ---------------------------------------------------------------
# Where the web app's server-side code reaches the API.
API_URL="http://localhost:4000"
# Public base URL of the web app itself, used by NextAuth for OAuth callbacks.
AUTH_URL="http://localhost:3000"

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
